# EverParse's own Makefile for the C code generated by `3d --pulse`.
#
# This is a standalone variant of KaRaMeL's misc/Makefile.basic. Under
# `--pulse`, 3d invokes KaRaMeL with -skip-makefiles, so neither
# Makefile.basic nor Makefile.include is emitted in the output directory, and
# this file is used instead. Two reasons:
#
# - The generated code is self-contained: the Pulse runtime is bundled into
#   EverParse.h as static inline definitions, and nothing refers to krmllib.
#   So, unlike KaRaMeL's Makefile.basic, this one neither puts krmllib's
#   headers on the include path nor links against libkrmllib.a -- which a
#   KaRaMeL built with LOWSTAR=false does not even produce.
#
# - It belongs to EverParse: the compiler flags the generated C is held to are
#   EverParse's business, not KaRaMeL's.
#
# Since there is no Makefile.include to read the file list from, the C files
# are discovered with a wildcard over the output directory. Use as:
#
#   make -C <odir> -f $(EVERPARSE_HOME)/share/everparse/3d/Makefile.basic \
#     USER_TARGET=... USER_CFLAGS=...

CFLAGS	+= -I.
CFLAGS	+= -Wall -Wextra -Werror -std=c11 \
  -Wno-unknown-warning-option \
  -Wno-infinite-recursion \
  -g -fwrapv -D_BSD_SOURCE -D_DEFAULT_SOURCE
ifeq ($(OS),Windows_NT)
CFLAGS	+= -D__USE_MINGW_ANSI_STDIO
else
CFLAGS	+= -fPIC
endif
CFLAGS	+= $(USER_CFLAGS)

ALL_C_FILES ?= $(wildcard *.c)

SOURCES += $(ALL_C_FILES) $(USER_C_FILES)
ifneq (,$(BLACKLIST))
  SOURCES := $(filter-out $(BLACKLIST),$(SOURCES))
endif
OBJS 	+= $(patsubst %.c,%.o,$(SOURCES))

all: $(USER_TARGET)

$(USER_TARGET): $(OBJS)

AR ?= ar

%.a:
	$(AR) cr $@ $^

%.exe:
	$(CC) $(CFLAGS) -o $@ $^

%.so:
	$(CC) $(CFLAGS) -shared -o $@ $^

%.d: %.c
	@set -e; rm -f $@; \
	  $(CC) -MM -MG $(CFLAGS) $< > $@.$$$$; \
	  sed 's,\($(notdir $*)\)\.o[ :]*,$(dir $@)\1.o $@ : ,g' < $@.$$$$ > $@; \
	  rm -f $@.$$$$

include $(patsubst %.c,%.d,$(SOURCES))

clean:
	rm -rf *.o *.d $(USER_TARGET)
