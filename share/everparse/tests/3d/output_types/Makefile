EVERPARSE_HOME ?= $(realpath ../../../..)
export EVERPARSE_HOME
FSTAR_EXE ?= fstar.exe
EVERPARSE_CMD=$(EVERPARSE_HOME)/bin/3d.exe --fstar $(FSTAR_EXE) --pulse
SOURCE_FILES=TPoint.3d AnonStruct.3d AnonUnion.3d

all: interpret modules modules_batch

modules:
	+$(MAKE) -C $@

modules_batch:
	+$(MAKE) -C $@

# Each .3d file gets its own output directory. Under --pulse, EverParse.h is
# generated by KaRaMeL for each batch and pulls in that batch's external
# typedefs, so batches that share an output directory would clobber each
# other's EverParse.h -- and here several of these files declare output types
# of the same name.
interpret: $(SOURCE_FILES) TPoint.out AnonUnion.out AnonStruct.out ExternVector.out OutputBitFields.out
	$(EVERPARSE_CMD) --batch TPoint.3d --odir TPoint.out
	$(EVERPARSE_CMD) --batch AnonUnion.3d --odir AnonUnion.out
	$(EVERPARSE_CMD) --batch AnonStruct.3d --odir AnonStruct.out
	$(EVERPARSE_CMD) --batch ExternVector.3d --odir ExternVector.out
	$(EVERPARSE_CMD) --batch OutputBitFields.3d --odir OutputBitFields.out
	$(CXX) -o AnonStruct.out/test1 -I AnonStruct.out $(addprefix AnonStruct.out/, AnonStruct_OutputTypes.c AnonStruct.c AnonStructWrapper.c) TestAnonStruct.cpp
	./AnonStruct.out/test1
	$(CXX) -o TPoint.out/test2 -I TPoint.out $(addprefix TPoint.out/, TPoint_OutputTypes.c TPoint.c TPointWrapper.c) TestTPoint.cpp
	./TPoint.out/test2
	$(CC) -o ExternVector.out/test3 -I ExternVector.out -I . $(addprefix ExternVector.out/, ExternVector.c ExternVectorWrapper.c) ExternVectorDriver.c
	./ExternVector.out/test3

EVERPARSE_SRC_PATH := $(EVERPARSE_HOME)/src
include $(EVERPARSE_SRC_PATH)/karamel.Makefile

INCLUDES=$(EVERPARSE_HOME)/src/3d/prelude $(EVERPARSE_HOME)/src/3d/prelude/buffer $(EVERPARSE_HOME)/src/lowparse

FSTAR_OPTIONS += $(addprefix --include , $(INCLUDES))

%.fst-in %.fsti-in:
	@echo $(FSTAR_OPTIONS)

%.out:
	mkdir -p $@

.PHONY: all interpret modules modules_batch

clean:
	rm -rf *.out modules/obj modules_batch/basic.out

.PHONY: clean
