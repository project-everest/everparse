entrypoint
typedef struct _POINT {
  UINT32  x;
  UINT32  y { y >= 18 };
  UINT32  z;
} POINT;

// Regression test for field positions on a reused extern stream. The stream's
// own position is cumulative, but `field_pos_64` must report the offset of the
// field within the record currently being validated, i.e. relative to the
// position at which the wrapper was entered -- as in Low*, whose wrapper
// always passes a start position of 0. Validating twice on one stream is what
// exposes a cumulative field position.
entrypoint
typedef struct _FIELDPOS (mutable UINT64 *offset) {
  UINT32 x {:on-success
    var px = field_pos_64;
    *offset = px;
    return (px == 0);
  };
  UINT32 y {:on-success
    var py = field_pos_64;
    return (py == 4);
  };
} FIELDPOS;

// Regression test for truncation on an extern stream. `t_exact`, `t_at_most`
// and variable-size `nlist` all validate a sub-parser against a bounded view
// of the stream, and the client knows nothing of that bound: it reports what
// the underlying stream still holds. So the bound has to be enforced on this
// side, and a sub-parser that overruns it must fail rather than read on into
// the bytes that follow.
entrypoint
typedef struct _EXACT {
  UINT8  len;
  UINT16 body[:byte-size-single-element-array len];
  UINT8  trailer;
} EXACT;

entrypoint
typedef struct _ATMOST {
  UINT8  len;
  UINT16 body[:byte-size-single-element-array-at-most len];
  UINT8  trailer;
} ATMOST;

entrypoint
typedef struct _NLIST {
  UINT8  len;
  UINT16 body[:byte-size len];
  UINT8  trailer;
} NLIST;
