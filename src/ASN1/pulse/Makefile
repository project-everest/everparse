all: verify

EVERPARSE_HOME = $(realpath ../../..)
LOWPARSE_HOME = $(EVERPARSE_HOME)/lib/everparse/lowparse

ASN1_HOME = $(EVERPARSE_HOME)/lib/everparse/asn1
INCLUDE_PATHS += $(LOWPARSE_HOME) $(ASN1_HOME)/spec $(ASN1_HOME)/pulse $(realpath ..)

# The library (lib/everparse/asn1) is verified by the toplevel Makefile
# (`make asn1`), and the test schemas of .. by ../Makefile; only the test
# modules of this directory are checked here.
ALREADY_CACHED := *,-ASN1.Pulse.X509,

include $(EVERPARSE_HOME)/lib/everparse/pulse.Makefile
include $(EVERPARSE_HOME)/lib/everparse/common.Makefile

# Custard direct-to-C extraction (no KaRaMeL)
C_OUTPUT_DIR := _output
CUSTARD_C_FLAGS := --codegen C --custard_monomorphize_types true

$(C_OUTPUT_DIR)/%.c: %.fst.checked
	mkdir -p $(C_OUTPUT_DIR)
	$(FSTAR) $(CUSTARD_C_FLAGS) --custard_entry_module $* $*.fst -o $@

CC ?= cc
# -Wno-type-limits: the extracted length decoder keeps range checks that are
# tautologies on unsigned C types; -Wno-unused-variable: content validators
# that ignore their input (e.g. NULL) leave the slice split by the length
# check unused
TEST_CFLAGS := -std=c11 -Wall -Wextra -Werror -Wno-type-limits -Wno-unused-variable -O1

# The other C tests of the Pulse library, on the differential test schemas,
# are in share/everparse/tests/asn1/pulse (`make asn1-test` at the toplevel).
test: test-oracle test-corpus stack-check

# Oracle tests: the validators of share/everparse/tests/asn1/pulse
# (extracted there) on the test vectors and on the mutations generated by
# ../difftest, with the pure F* spec runner's verdicts as the oracle.
SHARE_TESTS := $(EVERPARSE_HOME)/share/everparse/tests/asn1
SHARE_PULSE := $(SHARE_TESTS)/pulse
SHARE_C_OUTPUT_DIR := $(SHARE_PULSE)/_output
DIFFTEST_DIR := $(SHARE_TESTS)/difftest
DIFFTEST_OUT := ../difftest/out

include $(SHARE_PULSE)/difftest.Makefile

$(addprefix $(SHARE_C_OUTPUT_DIR)/,$(addsuffix .c,$(DIFFTEST_MODULES))): share-extract
	@:

share-extract:
	+$(MAKE) -C $(SHARE_PULSE) extract

.SECONDEXPANSION:
$(C_OUTPUT_DIR)/test_%.exe: $(SHARE_C_OUTPUT_DIR)/ASN1.Pulse.DiffTest.$$($$*.module).c $(SHARE_PULSE)/test/driver.c
	mkdir -p $(C_OUTPUT_DIR)
	$(CC) $(TEST_CFLAGS) -I $(SHARE_C_OUTPUT_DIR) \
	  -DHEADER='"ASN1.Pulse.DiffTest.$($*.module).h"' \
	  -DVALIDATE=ASN1_Pulse_DiffTest_$($*.module)_$($*.entry) \
	  -o $@ $< $(SHARE_PULSE)/test/driver.c

test-oracle-%: $(C_OUTPUT_DIR)/test_%.exe
	python3 $(SHARE_PULSE)/test/vectors.py --type $($*.type) --oracle $(DIFFTEST_OUT)/ours.jsonl \
	  $(DIFFTEST_DIR)/vectors/$($*.vectors) $(DIFFTEST_OUT)/gen/mutations.json | $<

$(addprefix test-oracle-,$(C_TESTS)): $(DIFFTEST_OUT)/ours.jsonl
$(DIFFTEST_OUT)/ours.jsonl: FORCE
	+$(MAKE) -C ../difftest ours
FORCE:

test-oracle: $(addprefix test-oracle-,$(C_TESTS))

# Corpus tests: the X.509 certificate and CRL validators (ASN1.Pulse.X509)
# against the pure F* spec runner on ../evaluation/data
EVALUATION_DIR := ../evaluation
SPEC_RUNNER := $(EVALUATION_DIR)/ASN1_Parser.exe
CORPUS_TESTS := X509 CRL
X509.entry := validate_certificate
CRL.entry := validate_crl

$(C_OUTPUT_DIR)/corpus_%.exe: $(C_OUTPUT_DIR)/ASN1.Pulse.X509.c test/files_driver.c
	$(CC) $(TEST_CFLAGS) -I $(C_OUTPUT_DIR) \
	  -DHEADER='"ASN1.Pulse.X509.h"' \
	  -DVALIDATE=ASN1_Pulse_X509_$($*.entry) \
	  -o $@ $< test/files_driver.c

$(SPEC_RUNNER): FORCE
	$(MAKE) -C .. evaluation/ASN1_Parser.exe

$(EVALUATION_DIR)/data:
	$(MAKE) -C $(EVALUATION_DIR) prepare

test-corpus-%: $(C_OUTPUT_DIR)/corpus_%.exe $(SPEC_RUNNER) $(EVALUATION_DIR)/data
	python3 test/corpus.py --format $* --spec $(SPEC_RUNNER) --exe $< \
	  $(EVALUATION_DIR)/data/$*/positive $(EVALUATION_DIR)/data/$*/negative

test-corpus: $(addprefix test-corpus-,$(CORPUS_TESTS))

# Static stack bound: no recursion, and a bounded worst case, for the X.509
# and CRL entry points (from the compiler call graph, at -O0 = no inlining).
# gcc provides it with -fcallgraph-info=su; clang (the default cc on macOS)
# does not, so with clang, take frame sizes from -fstack-usage and the call
# graph from the LLVM IR.
STACK_BUDGET := 32768
STACK_ENTRIES := ASN1_Pulse_X509_validate_certificate ASN1_Pulse_X509_validate_crl
CC_IS_CLANG := $(shell $(CC) --version 2>/dev/null | grep -q clang && echo 1)
stack-check: $(C_OUTPUT_DIR)/ASN1.Pulse.X509.c test/stack.py
ifeq ($(CC_IS_CLANG),1)
	cd $(C_OUTPUT_DIR) && $(CC) -std=c11 -O0 -fstack-usage -c ASN1.Pulse.X509.c -o stack.o
	cd $(C_OUTPUT_DIR) && $(CC) -std=c11 -O0 -S -emit-llvm ASN1.Pulse.X509.c -o stack.ll
	python3 test/stack.py --budget $(STACK_BUDGET) \
	  --su $(C_OUTPUT_DIR)/stack.su --ll $(C_OUTPUT_DIR)/stack.ll $(STACK_ENTRIES)
else
	cd $(C_OUTPUT_DIR) && $(CC) -std=c11 -O0 -fcallgraph-info=su -c ASN1.Pulse.X509.c -o stack.o
	python3 test/stack.py --budget $(STACK_BUDGET) --ci $(C_OUTPUT_DIR)/stack.ci $(STACK_ENTRIES)
endif

.PRECIOUS: $(C_OUTPUT_DIR)/%.c $(C_OUTPUT_DIR)/%.h $(C_OUTPUT_DIR)/test_%.exe $(C_OUTPUT_DIR)/corpus_%.exe
.PHONY: test test-oracle test-corpus stack-check share-extract FORCE
