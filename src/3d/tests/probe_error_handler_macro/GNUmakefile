# This Makefile is meant to be used with GNU Make. It builds EverParse
# validators and parsers corresponding to the data formats specified
# in src/*.3d files, as well as a test program to run them.

# Default rule when `make` is run without argument. This rule MUST
# appear first, so we define it here and make it point to a `world`
# rule that will depend on variables defined in the
# EverParse-generated Makefile.
all: world

########################################################
# Variables needed by the EverParse-generated Makefile #
########################################################

# EVERPARSE_HOME: root of the EverParse tree (source tree or contents
# of the binary package.)
# EVERPARSE_HOME is necessary for the 3d executable. It needs to point to the
# root of the EverParse source tree. However, EVERPARSE_HOME is not needed if
# you run everparse.sh or everparse.cmd from the binary package.
EVERPARSE_HOME ?= $(realpath ../../../..)
export EVERPARSE_HOME

# Path to either the 3d executable or the everparse.sh or
# everparse.cmd script from the EverParse binary package
FSTAR_EXE ?= $(EVERPARSE_HOME)/fstar.sh
EVERPARSE_EXE=$(EVERPARSE_HOME)/bin/3d.exe --fstar $(FSTAR_EXE)

# Options passed to EverParse.
#
# --use_error_handler_macro makes the generated validators rely on the
# EVERPARSE_ERROR_HANDLER_MACRO C macro instead of a dynamic
# error-handler callback.  --add_include injects the user-provided
# macro definition (src/MyErrorHandlerMacro.h) into every generated
# .c/.h file.
EVERPARSE_OPTIONS=--use_error_handler_macro --add_include '"MyErrorHandlerMacro.h"'

# Command to run EverParse
EVERPARSE_CMD=$(EVERPARSE_EXE) $(EVERPARSE_OPTIONS)

# Output directory for .c/.h files as well as temporary files (.fst,
# .krml, etc.)
EVERPARSE_OUTPUT_DIR=obj

# Input directory containing .3d (and auxiliary .3d.copyright.txt)
# files
EVERPARSE_INPUT_DIR=src

#########################################
# Generating and including the Makefile #
#########################################

# Define the name and path of the generated Makefile. We cleverly
# decide to have it generated into the output directory along with all
# temporary files.
everparse_makefile=$(EVERPARSE_OUTPUT_DIR)/EverParse.Makefile

# Create the output directory if it does not exist
$(EVERPARSE_OUTPUT_DIR):
	mkdir -p $@

# Generate the Makefile if any .3d file is modified.  We also depend on
# the handwritten error-handler macro header, and copy it into the
# output directory so the generated (--add_include'd) code can find it.
$(everparse_makefile): $(wildcard src/*.3d) $(EVERPARSE_INPUT_DIR)/MyErrorHandlerMacro.h $(EVERPARSE_OUTPUT_DIR)
	$(EVERPARSE_CMD) --makefile gmake --makefile_name $@ src/Probe.3d
	cp $(EVERPARSE_INPUT_DIR)/MyErrorHandlerMacro.h $(EVERPARSE_OUTPUT_DIR)/

# Include the generated Makefile
ifeq (,$(filter clean,$(MAKECMDGOALS)))
include $(everparse_makefile)
endif

#############################
# Building the test program #
#############################

# Collect all .o files to be built: add the .o files corresponding to
# the handwritten .c files, as well as those corresponding to the .c
# files generated by EverParse.
all_o_files=$(EVERPARSE_ALL_O_FILES) $(EVERPARSE_OUTPUT_DIR)/main.o $(EVERPARSE_OUTPUT_DIR)/error_handling.o 

# Compile the handwritten .c file. Since that file depends on .h files
# generated by EverParse, we need to include both the output directory
# and the EverParse library directory into the compiler's include
# path.

CFLAGS += -Wall

$(EVERPARSE_OUTPUT_DIR)/main.o: $(EVERPARSE_INPUT_DIR)/main.c $(EVERPARSE_OUTPUT_DIR)/ProbeWrapper.h
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

$(EVERPARSE_OUTPUT_DIR)/error_handling.o: $(EVERPARSE_INPUT_DIR)/error_handling.c
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

# Link the test program
$(EVERPARSE_OUTPUT_DIR)/test.exe: $(all_o_files)
	$(CC) $(LDFLAGS) -o $@ $^

# Run the test program
test: $(EVERPARSE_OUTPUT_DIR)/test.exe
	$<

#############################
# Test case generation      #
#############################

3D_Z3_EXECUTABLE ?= z3-4.13.3

$(EVERPARSE_OUTPUT_DIR)/testcases.c: $(EVERPARSE_INPUT_DIR)/Probe.3d
	$(EVERPARSE_CMD) --no_batch --z3_executable $(3D_Z3_EXECUTABLE) --odir $(EVERPARSE_OUTPUT_DIR) $< --z3_test Probe._primaryInPlace --z3_witnesses 10 --z3_branch_depth 5
	test -f $@

$(EVERPARSE_OUTPUT_DIR)/testcases.o: $(EVERPARSE_OUTPUT_DIR)/testcases.c $(EVERPARSE_ALL_H_FILES)
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

$(EVERPARSE_OUTPUT_DIR)/testgen.exe: $(EVERPARSE_ALL_O_FILES) $(EVERPARSE_OUTPUT_DIR)/testcases.o $(EVERPARSE_OUTPUT_DIR)/error_handling.o
	$(CC) $(LDFLAGS) -o $@ $^

testgen: $(EVERPARSE_OUTPUT_DIR)/testgen.exe
	$<

.PHONY: testgen

##############################################################
# Additional z3 test-case-generation modes under             #
# --use_error_handler_macro.  These exercise the two          #
# Z3TestGen.fst emitters other than the `--z3_test`/testgen   #
# path above:                                                 #
#                                                             #
#   * --z3_diff_test   (Z3TestGen.do_diff_test)               #
#   * --test_checker   (Z3TestGen.test_checker_c)             #
#                                                             #
# In macro mode the generated validators take no dynamic      #
# EVERPARSE_ERROR_HANDLER argument, so Z3TestGen omits the    #
# `&TestErrorHandler` argument (and its definition) from the  #
# harness; these targets therefore compile and run.           #
#                                                             #
# Each harness is generated into its own output directory so  #
# it does not clobber the shared obj/testcases.c, and is      #
# compiled against the validators/headers already produced in #
# obj (hence the `-I $(EVERPARSE_OUTPUT_DIR)`).               #
##############################################################

# --- Differential testing (--z3_diff_test) ---
# `namedPlain` and `namedPlainVariant` share the same (empty)
# signature but disagree on inputs where y == x, so z3 finds
# differential witnesses and the harness emits validator calls.
DIFF_OUTPUT_DIR=obj.difftest

$(DIFF_OUTPUT_DIR)/testcases.c: $(EVERPARSE_INPUT_DIR)/Probe.3d $(EVERPARSE_ALL_H_FILES)
	mkdir -p $(DIFF_OUTPUT_DIR)
	$(EVERPARSE_CMD) --no_batch --z3_executable $(3D_Z3_EXECUTABLE) --odir $(DIFF_OUTPUT_DIR) $< --z3_diff_test Probe._namedPlain,Probe._namedPlainVariant --z3_witnesses 3 --z3_branch_depth 3
	test -f $@

$(DIFF_OUTPUT_DIR)/testcases.o: $(DIFF_OUTPUT_DIR)/testcases.c $(EVERPARSE_ALL_H_FILES)
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

difftest: $(DIFF_OUTPUT_DIR)/testcases.o

.PHONY: difftest

# --- Standalone test-checker executable (--test_checker) ---
# `test1` is itself an `entrypoint probe` type; z3-testgen builds a
# standalone checker executable around its underlying validator
# ProbeValidateTest1, which under the macro takes no error-handler
# argument.
CHECKER_OUTPUT_DIR=obj.checkertest

$(CHECKER_OUTPUT_DIR)/testcases.c: $(EVERPARSE_INPUT_DIR)/Probe.3d $(EVERPARSE_ALL_H_FILES)
	mkdir -p $(CHECKER_OUTPUT_DIR)
	$(EVERPARSE_CMD) --no_batch --z3_executable $(3D_Z3_EXECUTABLE) --odir $(CHECKER_OUTPUT_DIR) $< --test_checker Probe._test1
	test -f $@

$(CHECKER_OUTPUT_DIR)/testcases.o: $(CHECKER_OUTPUT_DIR)/testcases.c $(EVERPARSE_ALL_H_FILES)
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

checkertest: $(CHECKER_OUTPUT_DIR)/testcases.o

.PHONY: checkertest

# --- `--z3_test` on an `entrypoint probe` type ---
# The `testgen` target above runs --z3_test on `primaryInPlace`, a
# plain `entrypoint` that carries a *probe field* + copy buffer.  Here
# we additionally run --z3_test on `test2`, which is an `entrypoint
# probe` type (the whole struct is probed, via ProbeInPlace AND
# ProbeAndCopy) and also takes a scalar parameter.  z3-testgen tests
# its underlying validator ProbeValidateTest2, covering `entrypoint
# probe` types under the macro.
EPROBE_OUTPUT_DIR=obj.eprobetest

$(EPROBE_OUTPUT_DIR)/testcases.c: $(EVERPARSE_INPUT_DIR)/Probe.3d $(EVERPARSE_ALL_H_FILES)
	mkdir -p $(EPROBE_OUTPUT_DIR)
	$(EVERPARSE_CMD) --no_batch --z3_executable $(3D_Z3_EXECUTABLE) --odir $(EPROBE_OUTPUT_DIR) $< --z3_test Probe._test2 --z3_witnesses 3 --z3_branch_depth 3
	test -f $@

$(EPROBE_OUTPUT_DIR)/testcases.o: $(EPROBE_OUTPUT_DIR)/testcases.c $(EVERPARSE_ALL_H_FILES)
	$(CC) $(CFLAGS) -I $(EVERPARSE_OUTPUT_DIR) -c -o $@ $<

eprobetest: $(EPROBE_OUTPUT_DIR)/testcases.o

.PHONY: eprobetest

###########
# Cleanup #
###########

# Since everything is output to the same directory, including the
# generated Makefile, it is enough to remove that directory.  We also
# remove the per-mode output directories used by difftest/checkertest.
clean-files:
	rm -rf $(EVERPARSE_OUTPUT_DIR) $(DIFF_OUTPUT_DIR) $(CHECKER_OUTPUT_DIR) $(EPROBE_OUTPUT_DIR)

.PHONY: clean-files

clean-testgen:
	+$(MAKE) -C $(EVERPARSE_INPUT_DIR) clean

.PHONY: clean-testgen

clean: clean-files clean-testgen

#######################################################
# Specifying the `world` rule run by the default rule #
#######################################################

# Specify the behavior of the default rule.  In addition to the core
# validator test (`test`), we exercise all three z3 test-generation
# modes under --use_error_handler_macro (`eprobetest` additionally
# covers an `entrypoint probe` type).
world: test testgen difftest checkertest eprobetest

# Declare all phony rules.
# Cf. https://www.gnu.org/software/make/manual/html_node/Phony-Targets.html
.PHONY: all world test testgen difftest checkertest eprobetest clean ci
