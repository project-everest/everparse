module EverParse3d.CAbi.ErrorFramePulse
open Pulse.Lib.Pervasives
#lang-pulse

(* The default error handler called by the wrappers generated by
   `3d --api pulse`. Its C signature is that of the `--api lowstar` one, except
   that the input is a plain `uint8_t *`, which the wrappers do not use. *)

module P = EverParse3d.CAbi.ErrorFrame
module R = Pulse.Lib.Reference
module U8 = FStar.UInt8
module U64 = FStar.UInt64
module B = EverParse3d.CAbi.Boolean

[@@FStar.Attributes.rename_let "EverParseDefaultErrorHandler"; FStar.Attributes.CInline]
fn default_error_handler
  (typename_s fieldname reason: string)
  (error_code: U64.t) (context: R.ref P.error_frame)
  (input: Pulse.Lib.ArrayPtr.ptr U8.t) (start_pos: U64.t)
  (#frame: Ghost.erased P.error_frame)
requires R.pts_to context (Ghost.reveal frame)
returns _: unit
ensures R.pts_to context
  (if B.to_bool (Ghost.reveal frame).P.filled then Ghost.reveal frame else
    { P.filled = B.of_bool true; P.start_pos = start_pos; P.typename_s = typename_s;
      P.fieldname = fieldname; P.reason = reason; P.error_code = error_code })
{
  P.record_error typename_s fieldname reason error_code context start_pos
}
