# EverParse's standalone Makefile for Custard-generated C.
#
# Direct C extraction emits no makefiles.
# `--api lowstar` copies it to the output directory unless
# `--skip_c_makefiles` is specified, retaining the legacy build entrypoint.
# Reasons for using our own Makefile:
#
# - The generated code is self-contained: the Pulse runtime is bundled into
#   EverParse.h as static inline definitions, with no separate runtime library
#   to build or link.
#
# - EverParse controls the compiler flags used to build the generated C.
#
# Since there is no Makefile.include to read the file list from, the C files
# are discovered with a wildcard over the output directory. Use as:
#
#   make -C <odir> -f $(EVERPARSE_HOME)/lib/everparse/3d/Makefile.basic \
#     USER_TARGET=... USER_CFLAGS=...

CFLAGS	+= -I.
CFLAGS	+= -Wall -Wextra -Werror -std=c11 \
  -Wno-unknown-warning-option \
  -Wno-infinite-recursion \
  -g -fwrapv -D_BSD_SOURCE -D_DEFAULT_SOURCE
ifeq ($(OS),Windows_NT)
CFLAGS	+= -D__USE_MINGW_ANSI_STDIO
else
CFLAGS	+= -fPIC
endif
CFLAGS	+= $(USER_CFLAGS)

ALL_C_FILES ?= $(wildcard *.c)

SOURCES += $(ALL_C_FILES) $(USER_C_FILES)
ifneq (,$(BLACKLIST))
  SOURCES := $(filter-out $(BLACKLIST),$(SOURCES))
endif
OBJS 	+= $(patsubst %.c,%.o,$(SOURCES))

all: $(USER_TARGET)

$(USER_TARGET): $(OBJS)

AR ?= ar

%.a:
	$(AR) cr $@ $^

%.exe:
	$(CC) $(CFLAGS) -o $@ $^

%.so:
	$(CC) $(CFLAGS) -shared -o $@ $^

%.d: %.c
	@set -e; rm -f $@; \
	  $(CC) -MM -MG $(CFLAGS) $< > $@.$$$$; \
	  sed 's,\($(notdir $*)\)\.o[ :]*,$(dir $@)\1.o $@ : ,g' < $@.$$$$ > $@; \
	  rm -f $@.$$$$

include $(patsubst %.c,%.d,$(SOURCES))

clean:
	rm -rf *.o *.d $(USER_TARGET)
